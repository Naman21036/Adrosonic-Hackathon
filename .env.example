APP_NAME=Adrosonic Dense Retrieval
HUGGINGFACE_API_KEY=
HF_DATASET_ID=sentence-transformers/msmarco-corpus
HF_DATASET_CONFIG=passage
HF_DATASET_SPLIT=train
EVAL_DATASET_ID=microsoft/ms_marco
EVAL_DATASET_CONFIG=v1.1
EVAL_DATASET_SPLIT=validation
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
BASELINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=1024
EMBEDDING_PRECISION=fp32
MODEL_REVISION=
QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query
DEVICE=cpu
BATCH_SIZE=32
DATA_LIMIT=100000
COLLECTION_NAME=msmarco_qwen3_embedding_0_6b
BASELINE_COLLECTION_NAME=msmarco_passages
QDRANT_PATH=./storage/qdrant
TOP_K=5
EF_SEARCH=64
HNSW_M=16
HNSW_EF_CONSTRUCT=100
LOG_LEVEL=INFO
OUTPUT_DIR=./artifacts
